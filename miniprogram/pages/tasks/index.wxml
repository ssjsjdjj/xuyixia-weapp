<view class="screen"><view class="row between"><text class="page-title">全部任务</text><button class="text-button" bindtap="onCreate">＋ 新建</button></view><text class="page-subtitle">包含非今日周期和暂停中的任务。</text><view wx:if="{{message}}" class="notice section-space">{{message}}</view><input class="field-input section-space" placeholder="搜索对象" value="{{query}}" bindinput="onSearch" /><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:elif="{{!visible.length}}" class="notice section-space">没有匹配的任务。</view><button wx:for="{{visible}}" wx:key="id" class="card task-row" data-id="{{item.id}}" bindtap="onDetail"><view class="row between"><text>{{item.pinned ? '置顶 · ' : ''}}{{item.name}}</text><text class="pill">{{!item.enabled ? '一直暂停' : item.scheduledToday ? '今日安排' : '非今日安排'}}</text></view><view class="field-tip">{{item.platformLabel}} · {{item.time}}</view><view class="field-tip">{{item.repeatLabel}}</view></button></view>
