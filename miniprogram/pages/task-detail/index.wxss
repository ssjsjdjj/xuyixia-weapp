@import "../shared.wxss";
.detail-avatar { width: 112rpx; height: 112rpx; border-radius: 31rpx; font-size: 45rpx; margin-top: 30rpx; }
.detail-title { margin-top: 24rpx; word-break: break-all; }
.detail-badges { margin-top: 23rpx; }
.detail-badges .pill { margin-right: 12rpx; }
.info-card { padding: 27rpx; margin-top: 33rpx; font-size: 25rpx; }
.reminder-time { font-size: 30rpx; font-weight: 600; }
.note-detail { border-top: 1rpx solid #eceee7; margin-top: 24rpx; padding-top: 22rpx; }
.note-text { white-space: pre-wrap; word-break: break-all; line-height: 1.8; margin-top: 8rpx; color: #5b705e; }
.greeting-card { background: #f1ede2; color: #7c7964; border-radius: 23rpx; line-height: 1.9; padding: 27rpx; margin-top: 10rpx; white-space: pre-wrap; word-break: break-all; }
.reminder-actions { margin-top: 22rpx; overflow: hidden; }
.reminder-row { display: flex; text-align: left; width: 100%; padding: 25rpx; background: transparent; border-radius: 0; font-weight: 400; }
.reminder-name { font-size: 26rpx; color: #3d5e46; }
.reminder-caption { font-size: 20rpx; margin-top: 8rpx; }
.manage-actions { justify-content: center; margin-top: 29rpx; }
.manage-dot { color: #bcc1b3; padding: 0 28rpx; }
.delete-button { color: #aa7562; }
.saved-notice { padding: 24rpx; margin-bottom: 26rpx; border-radius: 20rpx; background: #e8efe2; color: #48664b; font-size: 24rpx; line-height: 1.7; }
.saved-title { font-weight: 600; font-size: 28rpx; margin-bottom: 6rpx; }
.instruction-title { color: #3c5f46; font-weight: 600; margin-bottom: 12rpx; }
.copy-feedback { display: block; margin-top: 14rpx; color: #48664b; font-size: 24rpx; line-height: 1.7; }
.calendar-warning { display: block; margin-top: 14rpx; color: #976539; font-size: 24rpx; line-height: 1.7; }
.return-button { margin-top: 30rpx; }
