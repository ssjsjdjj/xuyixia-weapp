<view class="screen">
  <view wx:if="{{loading}}" class="loading">正在读取这件小事…</view>
  <view wx:elif="{{loadError}}" class="card empty"><view class="empty-title">详情暂时未能加载</view><button class="secondary" bindtap="refresh">重新加载</button></view>
  <view wx:elif="{{!task}}" class="card empty"><view class="empty-title">这件小事已不存在</view><view class="empty-text">返回清单，看看其他在意的事。</view></view>
  <block wx:else>
    <view wx:if="{{syncMessage}}" class="notice">{{syncMessage}}</view>
    <view wx:if="{{isNew}}" class="saved-notice"><view class="saved-title">任务已保存</view><text>接下来选择提醒方式。只保存清单不会自动通知你。</text></view>
    <view class="row between"><text class="eyebrow">每日小事 · {{task.platformLabel}}</text><button class="text-button" bindtap="onEdit" disabled="{{busy}}">编辑</button></view>
    <view class="detail-avatar avatar {{task.type}}">{{task.avatar}}</view>
    <text class="page-title detail-title">{{task.name}}</text>
    <view class="row detail-badges"><text class="pill {{task.completed ? 'green' : 'orange'}}">{{task.completed ? '今天已确认' : task.scheduledToday ? '今天待确认' : '今天未安排'}}</text><text class="pill">{{task.pinned ? '已置顶' : task.enabled ? '周期任务' : '已暂停'}}</text></view>
    <view class="card info-card"><view class="row between"><text class="muted">希望提醒的时间</text><text class="reminder-time">{{task.time}}</text></view><view class="field-tip">{{task.repeatLabel}}</view><view class="row"><button class="text-button" bindtap="onPin" disabled="{{busy}}">{{task.pinned ? '取消置顶' : '置顶重要对象'}}</button><button class="text-button" bindtap="onDuplicate" disabled="{{busy}}">复制为新任务</button></view><view wx:if="{{task.note}}" class="note-detail"><text class="small muted">备注</text><view class="note-text">{{task.note}}</view></view></view>
    <view wx:if="{{isNew}}" class="section-space"><text class="section-title">提醒方式</text><view class="reminder-actions card"><button class="reminder-row row between" bindtap="onCalendar" loading="{{calendarBusy}}" disabled="{{calendarBusy || !task.enabled}}"><view class="grow"><view class="reminder-name">{{reminderStatus.calendarAdded ? '查看或重新添加日历' : '添加手机日历提醒'}}</view><view class="small muted reminder-caption">{{reminderStatus.calendarHint}}</view></view><text class="chevron">›</text></button><view class="divider"></view><button class="reminder-row row between" bindtap="onSubscribe" loading="{{subscribeBusy}}" disabled="{{subscribeBusy}}"><view class="grow"><view class="reminder-name">微信消息提醒 · {{reminderStatus.wechatConfigured ? '需主动订阅' : '暂未启用'}}</view><view class="small muted reminder-caption">{{reminderStatus.wechatConfigured ? '一次性订阅不代表永久每天通知' : '当前可先使用清单和手机日历'}}</view></view><text class="chevron">›</text></button></view><text wx:if="{{reminderStatus.calendarNeedsReview}}" class="calendar-warning">请在手机日历单独调整原日程，勿直接重复添加。</text></view>
    <button wx:if="{{isNew}}" class="secondary return-button" bindtap="onToday">返回今日清单</button>
    <button wx:if="{{isNew}}" class="text-button" bindtap="onStartTask">暂不设置，查看处理步骤</button>
    <block wx:if="{{!isNew}}">
    <view class="notice section-space"><view class="instruction-title">{{task.type === 'douyin' ? '续火花的处理步骤' : '微博打卡的处理步骤'}}</view><view>1. {{task.type === 'douyin' ? '自行打开抖音，找到对应好友。' : '自行打开微博，找到打卡目标。'}}</view><view>2. {{task.type === 'douyin' ? '按抖音当前规则完成互动。' : '完成对应的签到或打卡。'}}</view><view>3. 回到这里，点击「确认已完成」。</view></view>
    <view wx:if="{{task.greeting}}" class="section-space"><view class="row between"><text class="section-title">准备文案</text><button class="text-button" bindtap="onCopy">{{copied ? '再次复制' : '复制文案'}}</button></view><view class="greeting-card">{{task.greeting}}</view><text wx:if="{{copied}}" class="copy-feedback">已复制，尚未发送。请自行打开{{task.type === 'douyin' ? '抖音' : '微博'}}使用。</text></view>
    <view class="actions"><button class="{{task.completed ? 'secondary' : 'primary'}}" bindtap="onComplete" loading="{{busy}}" disabled="{{busy || loading || (!task.scheduledToday && !task.completed)}}">{{task.completed ? '撤销今天的确认' : task.scheduledToday ? '确认已完成' : '今天未安排'}}</button><text class="button-caption">请先在对应平台完成操作。这里只记录你的确认。</text></view>
    <view class="section-space"><text class="section-title">提醒方式</text><view class="reminder-actions card"><button class="reminder-row row between" bindtap="onCalendar" loading="{{calendarBusy}}" disabled="{{calendarBusy || !task.enabled}}"><view class="grow"><view class="reminder-name">{{reminderStatus.calendarAdded ? '查看或重新添加日历' : '添加手机日历提醒'}}</view><view class="small muted reminder-caption">{{reminderStatus.calendarHint}}</view></view><text class="chevron">›</text></button><view class="divider"></view><button class="reminder-row row between" bindtap="onSubscribe" loading="{{subscribeBusy}}" disabled="{{subscribeBusy}}"><view class="grow"><view class="reminder-name">微信消息提醒 · {{reminderStatus.wechatConfigured ? '需主动订阅' : '暂未启用'}}</view><view class="small muted reminder-caption">{{reminderStatus.wechatConfigured ? '一次性订阅不代表永久每天通知' : '当前可先使用清单和手机日历'}}</view></view><text class="chevron">›</text></button></view><text wx:if="{{reminderStatus.calendarNeedsReview}}" class="calendar-warning">请在手机日历单独调整原日程，勿直接重复添加。</text></view>
    </block>
    <view class="manage-actions row"><button class="text-button" bindtap="onPauseWeek" disabled="{{busy}}">暂停一周</button><button class="text-button" bindtap="onToggle" disabled="{{busy}}">{{task.enabled && !temporarilyPaused ? '一直暂停' : '立即恢复'}}</button><button class="text-button delete-button" bindtap="onDelete" disabled="{{busy}}">删除</button></view>
  </block>
</view>
