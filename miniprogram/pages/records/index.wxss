@import "../shared.wxss";
.date-card { margin-top: 35rpx; padding: 24rpx 10rpx; }
.date-arrow { width: 75rpx; padding: 14rpx; font-size: 38rpx; color: #6b8465; background: transparent; }
.date-picker { text-align: center; padding: 5rpx 45rpx; }
.selected-date { font-size: 29rpx; font-weight: 600; }
.date-picker-caption { margin-top: 9rpx; font-size: 22rpx; color: #929b8d; }
.date-picker-caption text { margin-left: 9rpx; }
.record-count { color: #a47543; }
.record-list { margin-top: 24rpx; }
.record-card { padding: 25rpx; margin-bottom: 18rpx; }
.record-info { padding: 0 19rpx; }
.record-name { font-size: 28rpx; font-weight: 600; word-break: break-all; }
.record-meta { color: #929a8c; font-size: 21rpx; margin-top: 11rpx; }
.undo-button { padding: 14rpx 18rpx; background: #f0f2e9; color: #73846b; font-size: 23rpx; flex-shrink: 0; }
.record-footnote { display: block; text-align: center; font-size: 21rpx; line-height: 1.8; color: #a0a596; margin-top: 30rpx; }
